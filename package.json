{
  "name": "amazon-pinterest-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local CLI that turns Amazon affiliate products into reviewed Pinterest Pins.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts run",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "test": "vitest run",
    "build": "tsc && vite build",
    "collect": "tsx src/index.ts collect",
    "draft": "tsx src/index.ts draft",
    "review": "tsx src/index.ts review",
    "publish": "tsx src/index.ts publish",
    "clear": "tsx src/index.ts clear",
    "dev:api": "tsx src/server/localApiServer.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p src/client/tsconfig.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "playwright": "^1.46.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^8.0.14",
    "vitest": "^3.2.4"
  }
}
