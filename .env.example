# Amazon Product Advertising API (PA-API 5)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.com

# Pinterest API v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Copy generation (pick one — leave both empty to use deterministic template fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Behavior
DRY_RUN=true
AMAZON_PROVIDER=mock
COPY_PROVIDER=template
LOG_LEVEL=info

# Playwright fallback (temporary — delete once PA-API access is granted)
# Headful by default so you can see what's happening. Set to true to hide window.
PLAYWRIGHT_HEADLESS=false
AMAZON_BESTSELLER_MAX_PRODUCTS=9
# Per-category hard cap. Optional. Defaults to ceil(MAX_PRODUCTS / sources).
AMAZON_BESTSELLER_MAX_PER_CATEGORY=3
